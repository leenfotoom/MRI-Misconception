# Core
DATABASE_URL=postgresql+psycopg://misconception:misconception@localhost:55432/misconception_mri
AUTO_CREATE_SCHEMA=1
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
APP_BASE_URL=http://localhost:3000

# Session security
SESSION_COOKIE_NAME=mri_session
SESSION_DAYS=14
SESSION_COOKIE_SECURE=0
SESSION_COOKIE_SAMESITE=lax
# SESSION_COOKIE_DOMAIN=
MAX_FAILED_LOGINS=5
LOGIN_LOCK_MINUTES=15

# Email
EMAIL_MODE=console
EXPOSE_DEV_EMAIL_LINKS=1
EMAIL_VERIFICATION_TTL_MINUTES=1440
PASSWORD_RESET_TTL_MINUTES=30
# EMAIL_MODE=resend
# RESEND_API_KEY=
# MAIL_FROM=Misconception MRI <accounts@yourdomain.com>

# AI
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_MODEL=@cf/openai/gpt-oss-120b
